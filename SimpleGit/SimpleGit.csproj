<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>SimpleGit.Program</StartupObject>
    <AssemblyTitle>SimpleGit</AssemblyTitle>
    <ApplicationIcon>git.ico</ApplicationIcon>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageOutputPath>$(NugetLocalPath)</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="git.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
    <PackageReference Include="SimpleWpf" Version="0.0.1" />
  </ItemGroup>

</Project>
